# ---------------------------------------------------------------------------
# Rihana Nursery — environment template
#
# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.
# No secret may ever be prefixed NEXT_PUBLIC_ — that prefix inlines the value
# into the client bundle. `npm run check:secrets` enforces this in CI.
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
# Canonical public origin. Used for absolute links in email and for the
# same-origin check on mutating requests.
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Database (Supabase Postgres) -------------------------------------------
# Dashboard -> Project Settings -> Database -> Connection string -> Prisma.
# DATABASE_URL is the pooled (pgbouncer, :6543) connection used by the app.
# DIRECT_URL is the direct (:5432) connection Prisma migrations require —
# migrations cannot run over a transaction pooler.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Sessions ---------------------------------------------------------------
# 32+ random bytes, base64. Generate: openssl rand -base64 48
# Rotating this invalidates every active session.
SESSION_SECRET=""
# Sliding session lifetime in days.
SESSION_TTL_DAYS="30"

# --- Object storage (S3-compatible) -----------------------------------------
# Supabase Storage speaks the S3 protocol, so the same driver serves dev and prod.
# Dashboard -> Storage -> S3 Access Keys -> New access key.
# The bucket MUST be private: photos are reachable only via short-lived signed
# URLs minted after an authorization check (§51).
STORAGE_DRIVER="s3"                       # s3 | local  (local = dev fallback only)
S3_ENDPOINT="https://<project-ref>.supabase.co/storage/v1/s3"
S3_REGION="us-east-1"
S3_BUCKET="rihana-photos"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"                # required for Supabase / MinIO / R2
# Lifetime of a generated image URL. Short by design.
SIGNED_URL_TTL_SECONDS="300"
# Only set once a CDN fronts the bucket. Leave blank to serve signed URLs directly.
CDN_BASE_URL=""

# --- Email ------------------------------------------------------------------
# `console` writes to stdout and the dev mailbox at /admin/dev/mailbox.
EMAIL_DRIVER="console"                    # console | resend
EMAIL_FROM="Rihana Nursery <hello@example.com>"
EMAIL_REPLY_TO=""
RESEND_API_KEY=""

# --- Web push (VAPID) -------------------------------------------------------
# Optional. Enables lock-screen push + the home-screen app badge for the PWA.
# Leave blank to disable push cleanly (the in-app bell still works). Generate a
# keypair with:  npx web-push generate-vapid-keys
# The public key is exposed to the browser (NEXT_PUBLIC_); the private key is a
# server secret and must never reach the client. Use a DIFFERENT pair per env.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact for push services, a mailto: or https: URL (required by the Web Push spec).
VAPID_SUBJECT="mailto:hello@example.com"

# --- Background jobs --------------------------------------------------------
# pg-boss runs on the same Postgres instance, in its own `pgboss` schema.
# In development the worker runs in-process; in production run `npm run worker`
# as a separate process so app servers stay stateless (§70).
JOBS_ENABLED="true"
JOBS_IN_PROCESS="true"                    # set false in production
JOB_CONCURRENCY="4"

# --- Uploads ----------------------------------------------------------------
MAX_UPLOAD_BYTES="15728640"               # 15 MB per file
MAX_UPLOAD_FILES_PER_BATCH="200"

# --- Rate limiting ----------------------------------------------------------
# Per-account: tight. This is what stops someone guessing one family's password.
RATE_LIMIT_LOGIN_MAX="8"
# Per-IP: deliberately much looser. A whole household shares one NAT, and every
# device in the nursery shares the office address — sizing this near the
# per-account limit would let one mistyped password lock out everyone behind the
# same router.
RATE_LIMIT_LOGIN_IP_MAX="50"
RATE_LIMIT_LOGIN_WINDOW_SECONDS="900"
RATE_LIMIT_INQUIRY_MAX="5"
RATE_LIMIT_INQUIRY_WINDOW_SECONDS="3600"

# --- Observability ----------------------------------------------------------
LOG_LEVEL="info"                          # trace | debug | info | warn | error
# Optional. Leave blank to disable error reporting entirely.
SENTRY_DSN=""

# --- Seeding ----------------------------------------------------------------
# Credentials for the first owner account created by `npm run db:seed`.
# Change these before seeding anything that is not a throwaway database.
SEED_OWNER_EMAIL="owner@rihana.test"
SEED_OWNER_PASSWORD=""
