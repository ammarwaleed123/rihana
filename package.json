{
  "name": "rihana",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "tsx --tsconfig tsconfig.worker.json src/lib/jobs/worker-entry.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "verify:auth": "tsx scripts/verify-auth.ts",
    "verify:pickup": "tsx scripts/verify-pickup.ts",
    "db:reset-limits": "tsx scripts/reset-limits.ts",
    "db:inspect": "tsx scripts/inspect-db.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx --tsconfig tsconfig.worker.json prisma/seed-demo.ts",
    "icons:generate": "tsx scripts/generate-icons.ts",
    "splash:generate": "tsx --tsconfig tsconfig.worker.json scripts/generate-splash.ts",
    "db:studio": "prisma studio",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "queue:warm": "tsx scripts/warm-queue.ts",
    "verify": "npm run typecheck && npm run lint && npm run check:secrets && npm run test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "@node-rs/argon2": "^2.0.2",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "file-type": "^22.0.1",
    "lucide-react": "^1.25.0",
    "next": "16.2.10",
    "next-intl": "^4.13.2",
    "pg": "^8.22.0",
    "pg-boss": "^12.26.1",
    "pino": "^10.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.17.2",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.15.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.2.4",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
